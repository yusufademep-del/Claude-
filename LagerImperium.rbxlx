	{ Id = "ShelfS", Name = "Kleines Regal", Cat = "Lager", Price = 150, Level = 1, W = 2, D = 1, Capacity = 10, Shelf = { Levels = 3, Spacing = 2 }, Build = buildShelf, Desc = "Platz für 10 Kisten" },
